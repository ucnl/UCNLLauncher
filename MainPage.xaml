<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="UCNLLauncher.MainPage"
             NavigationPage.HasNavigationBar="False"
             Shell.NavBarIsVisible="False"
             BackgroundColor="{AppThemeBinding Light={StaticResource UcnlBackgroundLight}, Dark={StaticResource UcnlBackgroundDark}}">

    <Grid RowDefinitions="Auto,*" ColumnDefinitions="*">

        <Grid x:Name="Toolbar"
              Grid.Row="0"
              BackgroundColor="{AppThemeBinding Light={StaticResource UcnlToolbarLight}, Dark={StaticResource UcnlToolbarDark}}"
              Padding="8"
              IsVisible="False"
              ColumnDefinitions="Auto,*">

            <Button x:Name="BtnBack"
                    Grid.Column="0"
                    TextColor="{AppThemeBinding Light={StaticResource UcnlOnAccentLight}, Dark={StaticResource UcnlOnAccentDark}}"
                    BackgroundColor="{AppThemeBinding Light={StaticResource UcnlAccentLight}, Dark={StaticResource UcnlAccentDark}}"
                    CornerRadius="8"
                    FontSize="14"
                    Padding="12,6"
                    Clicked="OnBackClicked" />

            <Label Grid.Column="1"
                   Text="UCNL Tools"
                   TextColor="{AppThemeBinding Light={StaticResource UcnlOnToolbarLight}, Dark={StaticResource UcnlOnToolbarDark}}"
                   FontSize="16"
                   VerticalOptions="Center"
                   HorizontalOptions="Center" />
        </Grid>

        <WebView x:Name="MainWebView"
                 Grid.Row="1"
                 HorizontalOptions="Fill"
                 VerticalOptions="Fill" />

        <ActivityIndicator x:Name="LoadingIndicator"
                           Grid.Row="1"
                           IsRunning="True"
                           IsVisible="True"
                           Color="{AppThemeBinding Light={StaticResource UcnlAccentLight}, Dark={StaticResource UcnlAccentDark}}"
                           VerticalOptions="Center"
                           HorizontalOptions="Center" />

    </Grid>

</ContentPage>
